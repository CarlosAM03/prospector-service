# Copy values into your shell/environment or Docker --env-file. Never commit real keys.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
INTERNAL_API_KEY=
CALLBACK_API_KEY=
PLATFORM_CALLBACK_ORIGIN=https://platform.example.invalid
ALLOW_LOCAL_CALLBACKS=false
# Windows baseline. Container selects Chromium explicitly for initial integration.
ENGINE_BROWSER=msedge
ENGINE_HEADLESS=false
ENGINE_WORKER_CONCURRENCY=1
QUEUE_CAPACITY=16
MAX_REGISTERED_JOBS=100
MAX_REQUEST_BYTES=65536
MAX_RESULT_BYTES=1048576
CALLBACK_TIMEOUT=5
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_BACKOFF=0.25
SHUTDOWN_GRACE_SECONDS=10
