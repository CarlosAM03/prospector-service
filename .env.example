# Development values; provide separate high-entropy secrets using the *_KEY_FILE settings.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
SOLUTION_ID=prospector-solution
ASSERTION_ISSUER=platform
ASSERTION_AUDIENCE=prospector-service/v1
PLATFORM_CALLBACK_ORIGIN=https://platform.example.invalid
METADATA_PATH=/var/lib/prospector/metadata.sqlite3
WORKER_TEMP_DIR=/dev/shm
ENGINE_BROWSER=chromium
ENGINE_HEADLESS=true
MAX_REQUEST_BYTES=65536
MAX_SNAPSHOT_BYTES=1048576
SNAPSHOT_BUDGET_BYTES=134217728
MAX_SNAPSHOTS=2048
IPC_MAX_BYTES=8388608
EXPORT_CONCURRENCY=4
MAX_EXPORT_BYTES=4194304
