# Copy outside the checkout and mount actual secret files separately.
SERVICE_IMAGE=prospector-service:bf150e4
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine
LISTEN_IP=127.0.0.1
HTTPS_PORT=8443
SOLUTION_ID=replace-with-platform-solution-id
ASSERTION_ISSUER=replace-with-platform-issuer
ASSERTION_AUDIENCE=prospector-service/v1
PLATFORM_CALLBACK_ORIGIN=https://platform.example.invalid
PLATFORM_CALLBACK_HOST=platform.example.invalid
PLATFORM_CALLBACK_IPV4=replace-with-verified-public-ipv4
PLATFORM_ALLOWLIST_FILE=/etc/prospector/platform-allow.conf
PROSPECTOR_SECCOMP_PROFILE=/etc/prospector/approved-seccomp.json
MAX_ACTIVE_BATCHES=1
SERVICE_API_KEY_FILE=/etc/prospector/secrets/service-api-key
PLATFORM_ASSERTION_KEY_FILE=/etc/prospector/secrets/platform-assertion-key
SQLITE_HMAC_KEY_FILE=/etc/prospector/secrets/sqlite-hmac-key
CALLBACK_API_KEY_FILE=/etc/prospector/secrets/callback-api-key
TLS_CERT_FILE=/etc/prospector/tls/fullchain.pem
TLS_KEY_FILE=/etc/prospector/tls/privkey.pem
SERVICE_CPUS=4
SERVICE_MEMORY_LIMIT=4g
SERVICE_PIDS_LIMIT=1024
SERVICE_SHM_SIZE=1g
WORKER_TMPFS_BYTES=536870912
MAX_SNAPSHOT_BYTES=1048576
SNAPSHOT_BUDGET_BYTES=134217728
MAX_SNAPSHOTS=2048
IPC_MAX_BYTES=8388608
EXPORT_CONCURRENCY=4
MAX_EXPORT_BYTES=4194304
